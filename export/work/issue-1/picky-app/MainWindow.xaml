<Window x:Class="PickyVPN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="PickyWindow"
        Title=""
        Width="720"
        Height="500"
        MinWidth="720"
        MinHeight="500"
        MaxWidth="720"
        MaxHeight="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#101B2D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#18263D" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0B1423" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F0E6" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#F4F0E6" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A6B1C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#B08D57" />
        <SolidColorBrush x:Key="OutlineBrush" Color="#A6B1C2" Opacity="0.20" />
        <SolidColorBrush x:Key="BaseRingBrush" Color="#A6B1C2" Opacity="0.50" />
        <SolidColorBrush x:Key="HoverBrush" Color="#B08D57" Opacity="0.11" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="182" />
            <Setter Property="Height" Value="132" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path x:Name="PrimarySurfaceFill" Data="M91,7 C162,7 175,16 175,66 C175,116 162,125 91,125 C20,125 7,116 7,66 C7,16 20,7 91,7 Z" Fill="{DynamicResource SurfaceBrush}" />
                            <Path x:Name="PrimaryBaseRing" Data="M91,2.5 C166,2.5 179.5,12.5 179.5,66 C179.5,119.5 166,129.5 91,129.5 C16,129.5 2.5,119.5 2.5,66 C2.5,12.5 16,2.5 91,2.5 Z" Stroke="{DynamicResource BaseRingBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path x:Name="PrimarySegmentRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurfaceFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CredentialTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="CredentialBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CredentialBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CredentialBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="BrandMark" Width="64" Height="64">
                        <Image x:Name="BrandMarkBody" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse Width="2.4" Height="2.4" Fill="{DynamicResource AccentBrush}" Canvas.Left="40.1" Canvas.Top="17.6" />
                    </Canvas>
                    <TextBlock Text="PickyVPN" Foreground="{DynamicResource SidebarTextBrush}" Margin="11,0,0,0" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonStyle}">
                        <Grid Width="124">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="HomeNavIcon" Data="M3,9 L12,2 L21,9 V20 C21,20.5304 20.7893,21.0391 20.4142,21.4142 C20.0391,21.7893 19.5304,22 19,22 H5 C4.46957,22 3.96086,21.7893 3.58579,21.4142 C3.21071,21.0391 3,20.5304 3,20 V9 Z M9,22 V12 H15 V22"
                                          Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="2" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="HomeNavLabel" Grid.Column="1" Text="Home" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}">
                        <Grid Width="124">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="SettingsNavIcon" Data="M12.22,2 H11.78 C11.2496,2 10.7409,2.21071 10.3658,2.58579 C9.99072,2.96086 9.78,3.46957 9.78,4 V4.18 C9.77964,4.53073 9.68706,4.87519 9.51154,5.17884 C9.33602,5.48248 9.08374,5.73464 8.78,5.91 L8.35,6.16 C8.04596,6.33554 7.70108,6.42795 7.35,6.42795 C6.99893,6.42795 6.65404,6.33554 6.35,6.16 L6.2,6.08 C5.74107,5.81526 5.19584,5.74344 4.684,5.88031 C4.17217,6.01717 3.73555,6.35154 3.47,6.81 L3.25,7.19 C2.98526,7.64893 2.91345,8.19416 3.05031,8.706 C3.18717,9.21783 3.52154,9.65445 3.98,9.92 L4.13,10.02 C4.43228,10.1945 4.68362,10.4451 4.85905,10.7468 C5.03448,11.0486 5.1279,11.391 5.13,11.74 V12.25 C5.1314,12.6024 5.03965,12.949 4.86405,13.2545 C4.68844,13.5601 4.43521,13.8138 4.13,13.99 L3.98,14.08 C3.52154,14.3456 3.18717,14.7822 3.05031,15.294 C2.91345,15.8058 2.98526,16.3511 3.25,16.81 L3.47,17.19 C3.73555,17.6485 4.17217,17.9828 4.684,18.1197 C5.19584,18.2566 5.74107,18.1847 6.2,17.92 L6.35,17.84 C6.65404,17.6645 6.99893,17.5721 7.35,17.5721 C7.70108,17.5721 8.04596,17.6645 8.35,17.84 L8.78,18.09 C9.08374,18.2654 9.33602,18.5175 9.51154,18.8212 C9.68706,19.1248 9.77964,19.4693 9.78,19.82 V20 C9.78,20.5304 9.99072,21.0391 10.3658,21.4142 C10.7409,21.7893 11.2496,22 11.78,22 H12.22 C12.7504,22 13.2591,21.7893 13.6342,21.4142 C14.0093,21.0391 14.22,20.5304 14.22,20 V19.82 C14.2204,19.4693 14.3129,19.1248 14.4885,18.8212 C14.664,18.5175 14.9163,18.2654 15.22,18.09 L15.65,17.84 C15.954,17.6645 16.2989,17.5721 16.65,17.5721 C17.0011,17.5721 17.346,17.6645 17.65,17.84 L17.8,17.92 C18.2589,18.1847 18.8042,18.2566 19.316,18.1197 C19.8278,17.9828 20.2645,17.6485 20.53,17.19 L20.75,16.8 C21.0147,16.3411 21.0866,15.7958 20.9497,15.284 C20.8128,14.7722 20.4785,14.3356 20.02,14.07 L19.87,13.99 C19.5648,13.8138 19.3116,13.5601 19.136,13.2545 C18.9604,12.949 18.8686,12.6024 18.87,12.25 V11.75 C18.8686,11.3976 18.9604,11.051 19.136,10.7455 C19.3116,10.4399 19.5648,10.1862 19.87,10.01 L20.02,9.92 C20.4785,9.65445 20.8128,9.21783 20.9497,8.706 C21.0866,8.19416 21.0147,7.64893 20.75,7.19 L20.53,6.81 C20.2645,6.35154 19.8278,6.01717 19.316,5.88031 C18.8042,5.74344 18.2589,5.81526 17.8,6.08 L17.65,6.16 C17.346,6.33554 17.0011,6.42795 16.65,6.42795 C16.2989,6.42795 15.954,6.33554 15.65,6.16 L15.22,5.91 C14.9163,5.73464 14.664,5.48248 14.4885,5.17884 C14.3129,4.87519 14.2204,4.53073 14.22,4.18 V4 C14.22,3.46957 14.0093,2.96086 13.6342,2.58579 C13.2591,2.21071 12.7504,2 12.22,2 Z M12,15 C13.6569,15 15,13.6569 15,12 C15,10.3431 13.6569,9 12,9 C10.3431,9 9,10.3431 9,12 C9,13.6569 10.3431,15 12,15 Z"
                                          Stroke="{DynamicResource SidebarTextBrush}" StrokeThickness="2" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="SettingsNavLabel" Grid.Column="1" Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Column="1" Margin="28,26,28,22" />
    </Grid>
</Window>
